            "text/plain": [
              "(-t + exp(t) - 1)*exp(-2*t)*Heaviside(t)"
            ],
            "text/latex": "$\\displaystyle \\left(- t + e^{t} - 1\\right) e^{- 2 t} \\theta\\left(t\\right)$"
          },
          "metadata": {},
          "execution_count": 1
        }
      ],
      "source": [
        "import sympy as sp\n",
        "\n",
        "t, s = sp.symbols('t s')\n",
        "X_s = 1 / ((s + 1)*(s + 2)**2)\n",
        "\n",
        "x_t = sp.inverse_laplace_transform(X_s, s, t)\n",
        "sp.simplify(x_t)\n"
      ]
